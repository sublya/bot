BOT_TOKEN=
# my.telegram.org, for the local Bot API server
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# any OpenAI-compatible audio/transcriptions endpoint; OpenRouter by default
STT_API_KEY=
STT_API_URL=https://openrouter.ai/api/v1
STT_MODEL=openai/whisper-large-v3-turbo
# how late the recogniser places word starts, seconds; empty for the tuned default
STT_LAG=
STT_DAILY_MINUTES=300
# language for users who never ran /lang; empty for autodetect, which mistakes Russian for English
DEFAULT_LANG=ru

ADMIN_IDS=
DAILY_VIDEOS=10
